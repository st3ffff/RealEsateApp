@model IEnumerable<RealEstateApp.Models.Message>

@{
    ViewData["Title"] = "Изпратени съобщения";
}

<h2>📤 Изпратени съобщения</h2>

@if (!Model.Any())
{
    <p>Нямате изпратени съобщения.</p>
}
else
{
    <table class="table table-dark table-hover text-center">
        <thead>
            <tr>
                <th>До</th>
                <th>Тема</th>
                <th>Съдържание</th>
                <th>Изпратено на</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var msg in Model)
            {
                <tr>
                    <td>@msg.Receiver.Email</td>
                    <td>@msg.Subject</td>
                    <td>@msg.Content</td>
                    <td>@msg.SentAt.ToLocalTime()</td>
                </tr>
            }
        </tbody>
    </table>
}
