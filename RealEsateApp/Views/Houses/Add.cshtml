@model RealEstateApp.Models.House
@using RealEstateApp.Models

@{
    ViewData["Title"] = "Добави нов имот";
}
@{
    ViewBag.PropertyTypes = Html.GetEnumSelectList<PropertyType>();
    ViewBag.PropertyCategories = Html.GetEnumSelectList<PropertyCategory>();
}

<h2 class="mb-4">Добави нов имот</h2>

<form asp-action="Add" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Заглавие</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Описание</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label">Цена</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PropertyType" class="form-label">Тип (Под наем / За продажба)</label>
        <select asp-for="PropertyType" class="form-select" asp-items="Html.GetEnumSelectList<PropertyType>()">
            <option value="">-- Избери тип --</option>
        </select>
        <span asp-validation-for="PropertyType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Category" class="form-label">Категория (тип имот)</label>
        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<PropertyCategory>()">
            <option value="">-- Избери категория --</option>
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label">Снимка (URL)</label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Добави</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
