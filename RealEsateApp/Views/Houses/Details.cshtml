@using RealEstateApp.Models
@model RealEstateApp.Models.House
@{
    ViewData["Title"] = "Детайли за имота";
}

<div class="container">
    <div class="card shadow-lg mb-4">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div style="position: relative;">
                <img src="@Model.ImageUrl" class="card-img-top" alt="Снимка на имота" style="max-height: 400px; object-fit: cover;">
                <div style="position: absolute; bottom: 0; left: 0; width: 100%; background: rgba(0,0,0,0.6); color: white; padding: 10px 20px;">
                    <h3>@Model.Title</h3>
                </div>
            </div>
        }

        <div class="card-body">
            <p class="card-text"><strong>Описание:</strong> @Model.Description</p>
            <p class="card-text"><strong>Цена:</strong> @Model.Price лв</p>
            <p class="card-text"><strong>Тип:</strong> @(Model.PropertyType == PropertyType.ForSale ? "За продажба" : "Под наем")</p>
            <p class="card-text"><strong>Категория:</strong> @Model.Category</p>
            <p class="card-text"><strong>Добавено от:</strong> @Model.Agent?.Email</p>

            <div class="d-flex gap-2 mt-4">
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Messages" asp-action="Create" asp-route-id="@Model.Agent.Id" class="btn btn-outline-primary">
                        ✉ Свържи се с агента
                    </a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-warning">
                        <i class="fas fa-user-plus"></i> Регистрирай се, за да се свържеш с агента
                    </a>
                }

                <a asp-action="All" class="btn btn-secondary">⬅️ Обратно към всички</a>
            </div>
        </div>
    </div>
</div>
