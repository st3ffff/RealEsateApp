@{
    ViewData["Title"] = "Стани един от нас";
}

<div class="container mt-5">
    <h2 class="text-center text-success mb-4">📄 Стани един от нас</h2>

    <p class="text-center mb-4">
        Искаш да станеш брокер? Качи своето CV и ще се свържем с теб!
    </p>

    <form asp-controller="JoinUs" asp-action="UploadCv" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="cvFile" class="form-label">Избери своето CV (PDF/DOCX):</label>
            <input type="file" name="cvFile" class="form-control" accept=".pdf,.doc,.docx" required />
        </div>
        <button type="submit" class="btn btn-primary">📤 Качи CV</button>
    </form>

    <div class="mt-5 text-center">
        <img src="https://cdn.pixabay.com/photo/2017/08/02/01/01/job-2566122_1280.jpg" class="img-fluid rounded" style="max-height: 300px;" alt="Join our team" />
    </div>
</div>
