@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "Всички потребители";
}

<h2 class="text-center mb-4">👥 Потребители</h2>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Имейл</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    <a asp-action="ChangeRole" asp-route-id="@user.Id" class="btn btn-warning btn-sm">Смени роля</a>
                    <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-danger btn-sm">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>
