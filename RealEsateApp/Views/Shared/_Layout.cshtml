<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEsateApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealEsateApp.styles.css" asp-append-version="true" />
    <!-- Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />


</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">RealEsateApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Houses" asp-action="All">Всички имоти</a></li>

                        @using Microsoft.AspNetCore.Identity
                        @inject UserManager<IdentityUser> UserManager

                        @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Broker")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-light" asp-controller="Houses" asp-action="Mine">Моите имоти</a>
                            </li>
                        }

                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Houses" asp-action="ForRent">Под наем</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Houses" asp-action="ForSale">За продажба</a></li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link text-light" asp-controller="Messages" asp-action="Inbox">Съобщения</a></li>
                        }
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link text-light" asp-controller="Messages" asp-action="Sent">Изпратени</a></li>
                        }

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link text-light" asp-controller="Messages" asp-action="Create">Ново съобщение</a></li>
                        }
                        @using Microsoft.AspNetCore.Identity
                        @inject UserManager<RealEstateApp.Models.ApplicationUser> UserManager
                        @inject SignInManager<RealEstateApp.Models.ApplicationUser> SignInManager

                        @{
                            var isLoggedIn = SignInManager.IsSignedIn(User);
                            var isAdmin = User.IsInRole("Admin");
                            var isBroker = User.IsInRole("Broker");
                        }
                        @if (User.Identity.IsAuthenticated)
                        @if (!isLoggedIn || (!isAdmin && !isBroker))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info fw-bold" asp-controller="JoinUs" asp-action="Index">
                                    🤝 Стани един от нас
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="d-flex ms-auto align-items-center">
                        <form class="d-flex me-3" asp-controller="Search" asp-action="Index" method="get">
                            <input class="form-control me-2" type="search" placeholder="Търси..." name="keyword">
                            <button class="btn btn-outline-success" type="submit">Търси</button>
                        </form>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="mb-0">
                                <button type="submit" class="btn btn-outline-danger">Изход</button>
                            </form>
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="nav-link text-success">Здравей, @User.Identity.Name</span>
                                <a class="nav-link text-light" asp-controller="Admin" asp-action="Index">👑 Админ Панел</a>
                            }
                        }
                        else
                        {
                            <a class="btn btn-outline-primary me-2" asp-area="Identity" asp-page="/Account/Login">Вход</a>
                            <a class="btn btn-outline-secondary" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
                        }

                        <button class="btn btn-outline-light ms-2" onclick="toggleTheme()">🌗</button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container pb-3">
        @RenderBody()
    </main>

    @* 
<footer class="footer mt-5 border-top text-muted">
    <div class="container text-center py-3">
        &copy; 2025 - RealEsateApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
*@


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_ValidationScriptsPartial" />

    <script>
        const toggleTheme = () => {
            const body = document.body;
            const isDark = body.classList.toggle('dark-theme');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        };

        document.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.body.classList.add('dark-theme');
            }
        });
    </script>
    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        @if (TempData["Success"] != null)
        {
            <text>
                    toastr.success("@TempData["Success"]");
            </text>
        }
        @if (TempData["Error"] != null)
        {
            <text>
                    toastr.error("@TempData["Error"]");
            </text>
        }
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

</body>
</html>

