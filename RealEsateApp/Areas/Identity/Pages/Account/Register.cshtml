@page
@model RealEsateApp.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <strong>⚠️ Грешка при регистрация:</strong>
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}


<div class="d-flex justify-content-center align-items-center vh-100 register-bg text-light">
    <div class="auth-card">
        <h2 class="text-center mb-4">📝 Регистрация в RealEsateApp</h2>
        <form method="post">
            <div class="form-group mb-3">
                <label asp-for="Input.Email" class="form-label">Имейл</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-0"><i class="fas fa-envelope form-icon"></i></span>
                    <input asp-for="Input.Email" class="form-control" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Input.Password" class="form-label">Парола</label>
                <div class="input-group">

                    <span class="input-group-text bg-dark border-0"><i class="fas fa-lock form-icon"></i></span>
                    <input asp-for="Input.Password" class="form-control" />
                    
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label">Повтори паролата</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-0"><i class="fas fa-lock form-icon"></i></span>
                    <input asp-for="Input.ConfirmPassword" class="form-control" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-success">✅ Регистрирай се</button>
            </div>

            <div class="text-center mt-3">
                <p>Вече имаш акаунт? <a asp-page="./Login" class="text-info">Влез тук</a></p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
